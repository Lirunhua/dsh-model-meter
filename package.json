{
  "name": "dsh-model-meter",
  "version": "0.5.3",
  "description": "Usage Panel: unofficial DeepSeek Harness sidebar for the selected model provider's GLM/Kimi quotas, reset times, and DeepSeek API balances.",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/preview.png",
    "docs/preview.svg",
    "docs/demo.html"
  ],
  "scripts": {
    "test": "node --test test/client.test.mjs test/host.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "glm",
    "kimi",
    "model-meter",
    "usage",
    "balance",
    "quota",
    "coding-plan",
    "usage-panel"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lirunhua/dsh-model-meter.git"
  },
  "homepage": "https://github.com/Lirunhua/dsh-model-meter#readme",
  "bugs": {
    "url": "https://github.com/Lirunhua/dsh-model-meter/issues"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
